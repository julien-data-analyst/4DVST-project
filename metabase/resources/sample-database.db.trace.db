2026-05-31 22:25:05 jdbc[3]: exception
org.h2.jdbc.JdbcSQLSyntaxErrorException: Table "FACT_CLIMAT_METEO_JOINED" not found; SQL statement:
-- Metabase:: userID: 1 queryType: native queryHash: 5c2b392a2f439e89bf88f9d0cf80070f81778c74dc7464f0db1565641afcc48f
WITH reference AS (
    SELECT
        AVG(avg_indice_secheresse_sols) AS ref_secheresse_sol,
        AVG(avg_indice_secheresse_precipitations) AS ref_secheresse_precip,
        AVG(avg_masse_volumique_neige) AS ref_neige,
        AVG(avg_precipitations_24h) AS ref_precip
    FROM fact_climat_meteo_joined
    WHERE year = 1996
      AND month = 1
)

SELECT
    date_trunc('month', measure_date_m) AS mois,

    AVG(avg_indice_secheresse_sols) AS secheresse_sol,

    (
      AVG(avg_indice_secheresse_sols)
      - ref.ref_secheresse_sol
    ) / ref.ref_secheresse_sol * 100
    AS secheresse_sol_pct,

    (
      AVG(avg_indice_secheresse_precipitations)
      - ref.ref_secheresse_precip
    ) / ref.ref_secheresse_precip * 100
    AS secheresse_precip_pct,

    (
      AVG(avg_masse_volumique_neige)
      - ref.ref_neige
    ) / ref.ref_neige * 100
    AS neige_pct,

    (
      AVG(avg_precipitations_24h)
      - ref.ref_precip
    ) / ref.ref_precip * 100
    AS precip_pct

FROM fact_climat_meteo_joined
CROSS JOIN reference ref
GROUP BY
    mois,
    ref.ref_secheresse_sol,
    ref.ref_secheresse_precip,
    ref.ref_neige,
    ref.ref_precip
ORDER BY mois; [42102-214]
